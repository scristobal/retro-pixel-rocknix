/*
 * FunnyPlaying RetroPixel Pocket (RK3326 variant, "V2")
 *
 * Hardware is essentially an Anbernic RG351M clone with a different
 * panel: JDI LT031MDZ4000 (3.1" 720x720 square IPS MIPI-DSI).
 * Battery is 3000 mAh instead of 3500 mAh. No rumble motor.
 */

/dts-v1/;
#include "rk3326-odroid-go.dtsi"

/ {
	model = "FunnyPlaying RetroPixel Pocket";
	compatible = "funnyplaying,rppocket", "rockchip,rk3326";

	battery: battery {
		compatible = "simple-battery";
		charge-full-design-microamp-hours = <3000000>;
		charge-term-current-microamp = <300000>;
		constant-charge-current-max-microamp = <1500000>;
		constant-charge-voltage-max-microvolt = <4200000>;
		factory-internal-resistance-micro-ohms = <180000>;
		voltage-max-design-microvolt = <4100000>;
		voltage-min-design-microvolt = <3500000>;

		ocv-capacity-celsius = <20>;
		ocv-capacity-table-0 =  <4046950 100>, <4001920 95>, <3967900 90>, <3919950 85>,
					<3888450 80>, <3861850 75>, <3831540 70>, <3799130 65>,
					<3768190 60>, <3745650 55>, <3726610 50>, <3711630 45>,
					<3696720 40>, <3685660 35>, <3674950 30>, <3663050 25>,
					<3649470 20>, <3635260 15>, <3616920 10>, <3592440 5>,
					<3574170 0>;
	};

};

/*
 * FunnyPlaying gates two panel power rails behind GPIO enable
 * lines.  The vendor BSP drives these HIGH to enable (see
 * panel_simple_prepare in the RPPocket BSP: gpio_set_value(vspn, 1)
 * and gpio_set_value(vcc5v_en, 1)).  The DTB flag of 0x01
 * (GPIO_ACTIVE_LOW) on those nodes is misleading — the driver uses
 * raw values, so physical HIGH = power on.
 *
 * The third GPIO listed in the vendor DTB (vcc_en_gpio on RK_PB4)
 * is actually consumed as an *input* pin for state detection
 * (gpio_direction_input in the vendor probe), NOT as a power gate,
 * so we leave it alone.
 *
 * Hog the two real power enables in their asserted (HIGH) state at
 * GPIO-controller probe time — these rails stay on for the
 * lifetime of the system, matching BSP semantics.
 */
&gpio0 {
	lcd-vspn-en-hog {
		gpio-hog;
		gpios = <RK_PA2 GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "lcd-vspn-en";
	};
};

&gpio3 {
	lcd-vcc5v-en-hog {
		gpio-hog;
		gpios = <RK_PC3 GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "lcd-vcc5v-en";
	};
};

&internal_display {
	compatible = "jdi,lt031mdz4000";
	iovcc-supply = <&vcc_lcd>;
	vdd-supply = <&vcc_lcd>;
	rotation = <270>;
};

&rk817_charger {
	/* This device does not have a current sense resistor */
	monitored-battery = <&battery>;
};
