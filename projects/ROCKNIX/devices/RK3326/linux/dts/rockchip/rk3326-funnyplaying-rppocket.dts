// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
/*
 * FunnyPlaying RetroPixel Pocket (RK3326 variant, "V2")
 *
 * Hardware is essentially an Anbernic RG351M clone with a different
 * panel: JDI LT031MDZ4000 (3.1" 720x720 square IPS MIPI-DSI).
 * Battery is 3000 mAh instead of 3500 mAh. No rumble motor.
 */

/dts-v1/;
#include "rk3326-odroid-go.dtsi"

/ {
	model = "FunnyPlaying RetroPixel Pocket";
	compatible = "funnyplaying,rppocket", "rockchip,rk3326";

	battery: battery {
		compatible = "simple-battery";
		charge-full-design-microamp-hours = <3000000>;
		charge-term-current-microamp = <300000>;
		constant-charge-current-max-microamp = <1500000>;
		constant-charge-voltage-max-microvolt = <4200000>;
		factory-internal-resistance-micro-ohms = <180000>;
		voltage-max-design-microvolt = <4100000>;
		voltage-min-design-microvolt = <3500000>;

		ocv-capacity-celsius = <20>;
		ocv-capacity-table-0 =  <4046950 100>, <4001920 95>, <3967900 90>, <3919950 85>,
					<3888450 80>, <3861850 75>, <3831540 70>, <3799130 65>,
					<3768190 60>, <3745650 55>, <3726610 50>, <3711630 45>,
					<3696720 40>, <3685660 35>, <3674950 30>, <3663050 25>,
					<3649470 20>, <3635260 15>, <3616920 10>, <3592440 5>,
					<3574170 0>;
	};

	/*
	 * FunnyPlaying wires three GPIO-controlled enable lines to the
	 * panel's physical power rails; the vendor DTB calls these
	 * vcc5v_en_gpio, vcc_en_gpio and vspn_en.  All three must be
	 * asserted (driven LOW, they're ACTIVE_LOW) before the panel
	 * can emit any light.  Model them as a chain of regulator-fixed
	 * nodes so the panel driver enabling vdd-supply pulls all three
	 * on via Linux's regulator framework.
	 */
	vcc5v_lcd: regulator-vcc5v-lcd {
		compatible = "regulator-fixed";
		regulator-name = "vcc5v_lcd";
		gpio = <&gpio3 RK_PC3 GPIO_ACTIVE_LOW>;
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		startup-delay-us = <2000>;
	};

	vcc_lcd_en: regulator-vcc-lcd-en {
		compatible = "regulator-fixed";
		regulator-name = "vcc_lcd_en";
		vin-supply = <&vcc5v_lcd>;
		gpio = <&gpio0 RK_PB4 GPIO_ACTIVE_LOW>;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		startup-delay-us = <2000>;
	};

	vspn_en: regulator-vspn-en {
		compatible = "regulator-fixed";
		regulator-name = "vspn_en";
		vin-supply = <&vcc_lcd_en>;
		gpio = <&gpio0 RK_PA2 GPIO_ACTIVE_LOW>;
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		startup-delay-us = <2000>;
	};
};

&internal_display {
	compatible = "jdi,lt031mdz4000";
	/*
	 * iovcc: LDO-supplied 2.8 V logic rail.  vdd: full power-rail
	 * chain (VSP/VSN + LCD-VCC + 5V) gated by three GPIOs.  Enabling
	 * vdd from the panel driver asserts all three enables in
	 * dependency order via the vin-supply chain above.
	 */
	iovcc-supply = <&vcc_lcd>;
	vdd-supply = <&vspn_en>;
	rotation = <270>;
};

&rk817_charger {
	/* This device does not have a current sense resistor */
	monitored-battery = <&battery>;
};
