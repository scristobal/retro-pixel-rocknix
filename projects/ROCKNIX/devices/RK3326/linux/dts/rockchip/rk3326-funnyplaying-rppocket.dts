/*
 * FunnyPlaying RetroPixel Pocket (RK3326 variant, "V2")
 *
 * Hardware is essentially an Anbernic RG351M clone with a different
 * panel: JDI LT031MDZ4000 (3.1" 720x720 square IPS MIPI-DSI).
 * Battery is 3000 mAh instead of 3500 mAh. No rumble motor.
 */

/dts-v1/;
#include "rk3326-odroid-go.dtsi"

/ {
	model = "FunnyPlaying RetroPixel Pocket";
	compatible = "funnyplaying,rppocket", "rockchip,rk3326";

	battery: battery {
		compatible = "simple-battery";
		charge-full-design-microamp-hours = <3000000>;
		charge-term-current-microamp = <300000>;
		constant-charge-current-max-microamp = <1500000>;
		constant-charge-voltage-max-microvolt = <4200000>;
		factory-internal-resistance-micro-ohms = <180000>;
		voltage-max-design-microvolt = <4100000>;
		voltage-min-design-microvolt = <3500000>;

		ocv-capacity-celsius = <20>;
		ocv-capacity-table-0 =  <4046950 100>, <4001920 95>, <3967900 90>, <3919950 85>,
					<3888450 80>, <3861850 75>, <3831540 70>, <3799130 65>,
					<3768190 60>, <3745650 55>, <3726610 50>, <3711630 45>,
					<3696720 40>, <3685660 35>, <3674950 30>, <3663050 25>,
					<3649470 20>, <3635260 15>, <3616920 10>, <3592440 5>,
					<3574170 0>;
	};

};

/*
 * FunnyPlaying gates two panel power rails behind GPIO enable
 * lines.  The vendor BSP drives these HIGH to enable (see
 * panel_simple_prepare in the RPPocket BSP: gpio_set_value(vspn, 1)
 * and gpio_set_value(vcc5v_en, 1)).  The DTB flag of 0x01
 * (GPIO_ACTIVE_LOW) on those nodes is misleading — the driver uses
 * raw values, so physical HIGH = power on.
 *
 * The third GPIO listed in the vendor DTB (vcc_en_gpio on RK_PB4)
 * is actually consumed as an *input* pin for state detection
 * (gpio_direction_input in the vendor probe), NOT as a power gate,
 * so we leave it alone.
 *
 * Hog the two real power enables in their asserted (HIGH) state at
 * GPIO-controller probe time — these rails stay on for the
 * lifetime of the system, matching BSP semantics.
 */
&gpio0 {
	lcd-vspn-en-hog {
		gpio-hog;
		gpios = <RK_PA2 GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "lcd-vspn-en";
	};
};

&gpio3 {
	lcd-vcc5v-en-hog {
		gpio-hog;
		gpios = <RK_PC3 GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "lcd-vcc5v-en";
	};
};

/*
 * Hardware differences in rk817 LDO wiring vs the RG351M dtsi we
 * inherit from.  Reading the factory DTB's rk817/regulators node
 * and cross-referencing the BSP panel-simple.c:
 *
 *            RG351M (mainline)      RPPocket (BSP/factory)
 *   LDO_REG1 not defined             backlight2v8_supply  2.8V
 *   LDO_REG7 vcc_bl         3.3V     lcd2v8_supply        2.8V
 *   LDO_REG8 vcc_lcd        2.8V     vcc_lcd              1.8V
 *
 * LDO_REG1 is the physical power rail to the backlight LED driver
 * and was therefore always off on this port — no current to the
 * LEDs no matter what pwm-backlight did.
 *
 * Define LDO_REG1, and adjust REG7/REG8 voltages to match the
 * RPPocket board.  Also point pwm-backlight at the backlight2v8
 * rail since that is where the LED power actually comes from.
 */
&rk817 {
	regulators {
		backlight2v8: LDO_REG1 {
			regulator-name = "backlight2v8_supply";
			regulator-min-microvolt = <2800000>;
			regulator-max-microvolt = <2800000>;
			regulator-always-on;
			regulator-boot-on;

			regulator-state-mem {
				regulator-off-in-suspend;
				regulator-suspend-microvolt = <2800000>;
			};
		};
	};
};

/* LDO_REG7 on RPPocket is the LCD logic 2.8V, not the 3.3V BL
 * supply of RG351M.  Bring the programmed voltage in line with
 * what the board wants.  (Label stays &vcc_bl because that is the
 * phandle name in the upstream dtsi; semantics are now
 * lcd2v8_supply on this device.) */
&vcc_bl {
	regulator-min-microvolt = <2800000>;
	regulator-max-microvolt = <2800000>;
};

/* LDO_REG8 on RPPocket is 1.8V, not 2.8V. */
&vcc_lcd {
	regulator-min-microvolt = <1800000>;
	regulator-max-microvolt = <1800000>;
};

&backlight {
	/* Route pwm-backlight's supply to LDO_REG1 (the actual LED
	 * power), not LDO_REG7 (mislabeled vcc_bl on RG351M). */
	power-supply = <&backlight2v8>;
};

&internal_display {
	compatible = "jdi,lt031mdz4000";
	/* iovcc = 1.8V logic rail (LDO_REG8, still called vcc_lcd in
	 * the upstream dtsi). vdd = 2.8V LCD main supply (LDO_REG7,
	 * still called vcc_bl in the upstream dtsi). */
	iovcc-supply = <&vcc_lcd>;
	vdd-supply = <&vcc_bl>;
	rotation = <270>;
};

&rk817_charger {
	/* This device does not have a current sense resistor */
	monitored-battery = <&battery>;
};
