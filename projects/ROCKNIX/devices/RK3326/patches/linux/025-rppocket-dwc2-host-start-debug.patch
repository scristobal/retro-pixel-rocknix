diff --git a/drivers/usb/dwc2/hcd.c b/drivers/usb/dwc2/hcd.c
index 64a4a03444d2..01c0b8e70e36 100644
--- a/drivers/usb/dwc2/hcd.c
+++ b/drivers/usb/dwc2/hcd.c
@@ -1645,17 +1645,24 @@ void dwc2_hcd_start(struct dwc2_hsotg *hsotg)
 {
 	u32 hprt0;
 
+	dev_info(hsotg->dev,
+		 "RPPDBG dwc2 hcd_start enter op=%d lx=%d gotgctl=0x%08x gusbcfg=0x%08x hprt0=0x%08x gintsts=0x%08x\n",
+		 hsotg->op_state, hsotg->lx_state, dwc2_readl(hsotg, GOTGCTL),
+		 dwc2_readl(hsotg, GUSBCFG), dwc2_readl(hsotg, HPRT0),
+		 dwc2_readl(hsotg, GINTSTS));
 	if (hsotg->op_state == OTG_STATE_B_HOST) {
 		/*
 		 * Reset the port. During a HNP mode switch the reset
 		 * needs to occur within 1ms and have a duration of at
 		 * least 50ms.
 		 */
 		hprt0 = dwc2_read_hprt0(hsotg);
 		hprt0 |= HPRT0_RST;
 		dwc2_writel(hsotg, hprt0, HPRT0);
+		dev_info(hsotg->dev, "RPPDBG dwc2 hcd_start b-host-reset hprt0=0x%08x\n",
+			 dwc2_readl(hsotg, HPRT0));
 	}
 
 	queue_delayed_work(hsotg->wq_otg, &hsotg->start_work,
 			   msecs_to_jiffies(50));
 }
@@ -4264,24 +4272,39 @@ static int _dwc2_hcd_start(struct usb_hcd *hcd)
 	if (dwc2_is_device_mode(hsotg)) {
 		spin_unlock_irqrestore(&hsotg->lock, flags);
 		return 0;	/* why 0 ?? */
 	}
 
+	dev_info(hsotg->dev,
+		 "RPPDBG dwc2 _hcd_start before-reinit gotgctl=0x%08x gusbcfg=0x%08x gintsts=0x%08x hprt0=0x%08x lx=%d op=%d\n",
+		 dwc2_readl(hsotg, GOTGCTL), dwc2_readl(hsotg, GUSBCFG),
+		 dwc2_readl(hsotg, GINTSTS), dwc2_readl(hsotg, HPRT0),
+		 hsotg->lx_state, hsotg->op_state);
 	dwc2_hcd_reinit(hsotg);
+	dev_info(hsotg->dev,
+		 "RPPDBG dwc2 _hcd_start after-reinit gotgctl=0x%08x gusbcfg=0x%08x gintsts=0x%08x hprt0=0x%08x\n",
+		 dwc2_readl(hsotg, GOTGCTL), dwc2_readl(hsotg, GUSBCFG),
+		 dwc2_readl(hsotg, GINTSTS), dwc2_readl(hsotg, HPRT0));
 
 	hprt0 = dwc2_read_hprt0(hsotg);
 	/* Has vbus power been turned on in dwc2_core_host_init ? */
 	if (hprt0 & HPRT0_PWR) {
 		/* Enable external vbus supply before resuming root hub */
 		spin_unlock_irqrestore(&hsotg->lock, flags);
+		dev_info(hsotg->dev, "RPPDBG dwc2 _hcd_start vbus-init-before hprt0=0x%08x\n",
+			 hprt0);
 		ret = dwc2_vbus_supply_init(hsotg);
-		if (ret)
+		dev_info(hsotg->dev, "RPPDBG dwc2 _hcd_start vbus-init ret=%d hprt0=0x%08x\n",
+			 ret, dwc2_readl(hsotg, HPRT0));
+		if (ret)
 			return ret;
 		spin_lock_irqsave(&hsotg->lock, flags);
 	}
 
 	/* Initialize and connect root hub if one is not already attached */
 	if (bus->root_hub) {
 		dev_dbg(hsotg->dev, "DWC OTG HCD Has Root Hub\n");
+		dev_info(hsotg->dev, "RPPDBG dwc2 _hcd_start resume-root-hub hprt0=0x%08x\n",
+			 dwc2_readl(hsotg, HPRT0));
 		/* Inform the HUB driver to resume */
 		usb_hcd_resume_root_hub(hcd);
 	}
