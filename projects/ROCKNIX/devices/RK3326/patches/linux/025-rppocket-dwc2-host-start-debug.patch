diff --git a/drivers/usb/dwc2/core_intr.c b/drivers/usb/dwc2/core_intr.c
index 5b251fc005a8..2fbac0d00a01 100644
--- a/drivers/usb/dwc2/core_intr.c
+++ b/drivers/usb/dwc2/core_intr.c
@@ -322,10 +322,17 @@ static void dwc2_handle_session_req_intr(struct dwc2_hsotg *hsotg)
 		dwc2_hsotg_disconnect(hsotg);
 	} else {
 		/* Turn on the port power bit. */
 		hprt0 = dwc2_read_hprt0(hsotg);
+		dev_info(hsotg->dev,
+			 "RPPDBG dwc2 session_req before-power gotgctl=0x%08x gusbcfg=0x%08x gintsts=0x%08x hprt0=0x%08x lx=%d op=%d\n",
+			 dwc2_readl(hsotg, GOTGCTL), dwc2_readl(hsotg, GUSBCFG),
+			 dwc2_readl(hsotg, GINTSTS), hprt0, hsotg->lx_state,
+			 hsotg->op_state);
 		hprt0 |= HPRT0_PWR;
 		dwc2_writel(hsotg, hprt0, HPRT0);
+		dev_info(hsotg->dev, "RPPDBG dwc2 session_req after-power hprt0=0x%08x\n",
+			 dwc2_readl(hsotg, HPRT0));
 		/* Connect hcd after port power is set. */
 		dwc2_hcd_connect(hsotg);
 	}
