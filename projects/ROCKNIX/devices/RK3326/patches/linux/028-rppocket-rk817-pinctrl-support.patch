From: FunnyPlaying RetroPixel Pocket port
Subject: [PATCH] mfd: rk8xx: support RK817 sleep-pin pinctrl states

The RPPocket routes the RK817 sleep pin through SoC and PMIC pinctrl states for
normal operation, suspend, and reset. Mainline's RK8xx core does not instantiate
the RK805 pinctrl child for RK809/RK817 or expose those variants' SLP function.

Add the vendor-derived RK817 sleep-pin definitions and bind the PMIC pinctrl
states to the existing RK8xx suspend/resume paths. Only the SLP pin is exposed;
the unrelated TS/GT GPIO muxes are not needed by this board. This support is
required by the board's validated RK817 sequencing patch.

---
--- a/drivers/mfd/rk8xx-core.c
+++ b/drivers/mfd/rk8xx-core.c
@@ -14,6 +14,8 @@
 #include <linux/mfd/rk808.h>
 #include <linux/mfd/core.h>
 #include <linux/module.h>
+#include <linux/pinctrl/consumer.h>
+#include <linux/platform_device.h>
 #include <linux/property.h>
 #include <linux/regmap.h>
 #include <linux/reboot.h>
@@ -692,6 +694,88 @@
 }
 EXPORT_SYMBOL_GPL(rk8xx_shutdown);
 
+static void rk817_pinctrl_unregister(void *data)
+{
+	platform_device_unregister(data);
+}
+
+static int rk817_pinctrl_init(struct device *dev, struct rk808 *rk808)
+{
+	struct platform_device *pinctrl_dev;
+	struct pinctrl_state *default_st;
+	int ret;
+
+	pinctrl_dev = platform_device_alloc("rk805-pinctrl",
+					    PLATFORM_DEVID_AUTO);
+	if (!pinctrl_dev)
+		return -ENOMEM;
+
+	pinctrl_dev->dev.parent = dev;
+
+	ret = platform_device_add(pinctrl_dev);
+	if (ret) {
+		platform_device_put(pinctrl_dev);
+		dev_err(dev, "failed to add rk805-pinctrl device: %d\n", ret);
+		return ret;
+	}
+
+	ret = devm_add_action_or_reset(dev, rk817_pinctrl_unregister,
+				       pinctrl_dev);
+	if (ret)
+		return ret;
+
+	if (rk808->pins && !IS_ERR(rk808->pins->p))
+		return 0;
+
+	rk808->pins = devm_kzalloc(dev, sizeof(*rk808->pins), GFP_KERNEL);
+	if (!rk808->pins)
+		return -ENOMEM;
+
+	rk808->pins->p = devm_pinctrl_get(dev);
+	if (IS_ERR(rk808->pins->p)) {
+		dev_dbg(dev, "no RK817 pinctrl handle\n");
+		rk808->pins->p = NULL;
+		return 0;
+	}
+
+	default_st = pinctrl_lookup_state(rk808->pins->p,
+					  PINCTRL_STATE_DEFAULT);
+	if (!IS_ERR(default_st)) {
+		ret = pinctrl_select_state(rk808->pins->p, default_st);
+		if (ret)
+			dev_dbg(dev,
+				"failed to activate default pinctrl state: %d\n",
+				ret);
+	}
+
+	rk808->pins->sleep = pinctrl_lookup_state(rk808->pins->p,
+						  "pmic-sleep");
+	if (IS_ERR(rk808->pins->sleep))
+		rk808->pins->sleep = NULL;
+
+	rk808->pins->reset = pinctrl_lookup_state(rk808->pins->p,
+						  "pmic-reset");
+	if (IS_ERR(rk808->pins->reset)) {
+		rk808->pins->reset = NULL;
+		return 0;
+	}
+
+	ret = regmap_update_bits(rk808->regmap, RK817_SYS_CFG(3),
+				 RK817_SLPPOL_MSK, RK817_SLPPOL_L);
+	if (ret) {
+		dev_err(dev, "failed to configure RK817 sleep polarity: %d\n",
+			ret);
+		return ret;
+	}
+
+	ret = pinctrl_select_state(rk808->pins->p, rk808->pins->reset);
+	if (ret)
+		dev_dbg(dev, "failed to activate reset pinctrl state: %d\n",
+			ret);
+
+	return 0;
+}
+
 int rk8xx_probe(struct device *dev, int variant, unsigned int irq, struct regmap *regmap)
 {
 	struct rk808 *rk808;
@@ -785,6 +869,13 @@
 	if (ret)
 		return dev_err_probe(dev, ret, "failed to add MFD devices\n");
 
+	if (rk808->variant == RK809_ID || rk808->variant == RK817_ID) {
+		ret = rk817_pinctrl_init(dev, rk808);
+		if (ret)
+			return dev_err_probe(dev, ret,
+					     "failed to initialize RK817 pinctrl\n");
+	}
+
 	if (device_property_read_bool(dev, "rockchip,system-power-controller") ||
 	    device_property_read_bool(dev, "system-power-controller")) {
 		ret = devm_register_sys_off_handler(dev,
@@ -831,6 +922,11 @@
 					 RK817_SYS_CFG(3),
 					 RK817_SLPPIN_FUNC_MSK,
 					 SLPPIN_SLP_FUN);
+		if (ret)
+			break;
+		if (rk808->pins && rk808->pins->p && rk808->pins->sleep)
+			ret = pinctrl_select_state(rk808->pins->p,
+						   rk808->pins->sleep);
 		break;
 	default:
 		break;
@@ -852,6 +948,11 @@
 					 RK817_SYS_CFG(3),
 					 RK817_SLPPIN_FUNC_MSK,
 					 SLPPIN_NULL_FUN);
+		if (ret)
+			break;
+		if (rk808->pins && rk808->pins->p && rk808->pins->reset)
+			ret = pinctrl_select_state(rk808->pins->p,
+						   rk808->pins->reset);
 		break;
 	default:
 		break;
--- a/drivers/pinctrl/pinctrl-rk805.c
+++ b/drivers/pinctrl/pinctrl-rk805.c
@@ -15,6 +15,7 @@
 #include <linux/kernel.h>
 #include <linux/module.h>
 #include <linux/mfd/rk808.h>
+#include <linux/of.h>
 #include <linux/platform_device.h>
 #include <linux/pm.h>
 #include <linux/property.h>
@@ -98,6 +99,12 @@
 	RK816_PINMUX_GPIO,
 };
 
+enum rk817_pinmux_option {
+	RK817_PINMUX_FUN0 = 0,
+	RK817_PINMUX_FUN1 = 1,
+	RK817_PINMUX_FUN3 = 3,
+};
+
 enum {
 	RK805_GPIO0,
 	RK805_GPIO1,
@@ -113,6 +120,10 @@
 	RK816_GPIO0,
 };
 
+enum {
+	RK817_GPIO_SLP,
+};
+
 static const char *const rk805_gpio_groups[] = {
 	"gpio0",
 	"gpio1",
@@ -128,6 +139,10 @@
 	"gpio0",
 };
 
+static const char *const rk817_gpio_groups[] = {
+	"gpio_slp",
+};
+
 /* RK805: 2 output only GPIOs */
 static const struct pinctrl_pin_desc rk805_pins_desc[] = {
 	PINCTRL_PIN(RK805_GPIO0, "gpio0"),
@@ -146,6 +161,11 @@
 	PINCTRL_PIN(RK816_GPIO0, "gpio0"),
 };
 
+/* RK817/RK809 sleep pin */
+static const struct pinctrl_pin_desc rk817_pins_desc[] = {
+	PINCTRL_PIN(RK817_GPIO_SLP, "gpio_slp"),
+};
+
 static const struct rk805_pin_function rk805_pin_functions[] = {
 	{
 		.name = "gpio",
@@ -209,6 +229,27 @@
 	},
 };
 
+static const struct rk805_pin_function rk817_pin_functions[] = {
+	{
+		.name = "pin_fun0",
+		.groups = rk817_gpio_groups,
+		.ngroups = ARRAY_SIZE(rk817_gpio_groups),
+		.mux_option = RK817_PINMUX_FUN0,
+	},
+	{
+		.name = "pin_fun1",
+		.groups = rk817_gpio_groups,
+		.ngroups = ARRAY_SIZE(rk817_gpio_groups),
+		.mux_option = RK817_PINMUX_FUN1,
+	},
+	{
+		.name = "pin_fun3",
+		.groups = rk817_gpio_groups,
+		.ngroups = ARRAY_SIZE(rk817_gpio_groups),
+		.mux_option = RK817_PINMUX_FUN3,
+	},
+};
+
 static const struct rk805_pin_group rk805_pin_groups[] = {
 	{
 		.name = "gpio0",
@@ -248,6 +289,14 @@
 	},
 };
 
+static const struct rk805_pin_group rk817_pin_groups[] = {
+	{
+		.name = "gpio_slp",
+		.pins = { RK817_GPIO_SLP },
+		.npins = 1,
+	},
+};
+
 #define RK805_GPIO0_VAL_MSK	BIT(0)
 #define RK805_GPIO1_VAL_MSK	BIT(1)
 
@@ -310,6 +359,14 @@
 	},
 };
 
+static const struct rk805_pin_config rk817_pin_cfgs[] = {
+	{
+		.reg = RK817_SYS_CFG(3),
+		.fun_reg = RK817_SYS_CFG(3),
+		.fun_msk = RK817_SLPPIN_FUNC_MSK,
+	},
+};
+
 /* generic gpio chip */
 static int rk805_gpio_get(struct gpio_chip *chip, unsigned int offset)
 {
@@ -496,6 +553,9 @@
 		return _rk805_pinctrl_set_mux(pctldev, offset, RK806_PINMUX_FUN5);
 	case RK816_ID:
 		return _rk805_pinctrl_set_mux(pctldev, offset, RK816_PINMUX_GPIO);
+	case RK809_ID:
+	case RK817_ID:
+		return _rk805_pinctrl_set_mux(pctldev, offset, RK817_PINMUX_FUN1);
 	}
 
 	return -ENOTSUPP;
@@ -603,9 +663,14 @@
 static int rk805_pinctrl_probe(struct platform_device *pdev)
 {
 	struct rk805_pctrl_info *pci;
+	struct device_node *np;
 	int ret;
 
-	device_set_node(&pdev->dev, dev_fwnode(pdev->dev.parent));
+	np = of_get_child_by_name(pdev->dev.parent->of_node, "pinctrl_rk8xx");
+	if (np)
+		pdev->dev.of_node = np;
+	else
+		device_set_node(&pdev->dev, dev_fwnode(pdev->dev.parent));
 
 	pci = devm_kzalloc(&pdev->dev, sizeof(*pci), GFP_KERNEL);
 	if (!pci)
@@ -657,6 +722,18 @@
 		pci->pin_cfg = rk816_gpio_cfgs;
 		pci->gpio_chip.ngpio = ARRAY_SIZE(rk816_gpio_cfgs);
 		break;
+	case RK809_ID:
+	case RK817_ID:
+		pci->pins = rk817_pins_desc;
+		pci->num_pins = ARRAY_SIZE(rk817_pins_desc);
+		pci->functions = rk817_pin_functions;
+		pci->num_functions = ARRAY_SIZE(rk817_pin_functions);
+		pci->groups = rk817_pin_groups;
+		pci->num_pin_groups = ARRAY_SIZE(rk817_pin_groups);
+		pci->pinctrl_desc.pins = rk817_pins_desc;
+		pci->pinctrl_desc.npins = ARRAY_SIZE(rk817_pins_desc);
+		pci->pin_cfg = rk817_pin_cfgs;
+		break;
 	default:
 		dev_err(&pdev->dev, "unsupported RK805 ID %lu\n",
 			pci->rk808->variant);
@@ -666,6 +743,8 @@
-	/* Add gpio chip */
-	ret = devm_gpiochip_add_data(&pdev->dev, &pci->gpio_chip, pci);
-	if (ret < 0) {
-		dev_err(&pdev->dev, "Couldn't add gpiochip\n");
-		return ret;
-	}
+	/* RK809/RK817 expose only the sleep pin as pinctrl, not as a GPIO. */
+	if (pci->gpio_chip.ngpio) {
+		ret = devm_gpiochip_add_data(&pdev->dev, &pci->gpio_chip, pci);
+		if (ret < 0) {
+			dev_err(&pdev->dev, "Couldn't add gpiochip\n");
+			return ret;
+		}
+	}
@@ -681,6 +760,8 @@
-	ret = gpiochip_add_pin_range(&pci->gpio_chip, dev_name(&pdev->dev),
-				     0, 0, pci->gpio_chip.ngpio);
-	if (ret < 0) {
-		dev_err(&pdev->dev, "Couldn't add gpiochip pin range\n");
-		return ret;
-	}
+	if (pci->gpio_chip.ngpio) {
+		ret = gpiochip_add_pin_range(&pci->gpio_chip, dev_name(&pdev->dev),
+					     0, 0, pci->gpio_chip.ngpio);
+		if (ret < 0) {
+			dev_err(&pdev->dev, "Couldn't add gpiochip pin range\n");
+			return ret;
+		}
+	}
--- a/include/linux/mfd/rk808.h
+++ b/include/linux/mfd/rk808.h
@@ -1339,6 +1339,15 @@
 	RK818_ID = 0x8180,
 };
 
+struct pinctrl;
+struct pinctrl_state;
+
+struct rk808_pin_info {
+	struct pinctrl *p;
+	struct pinctrl_state *reset;
+	struct pinctrl_state *sleep;
+};
+
 struct rk808 {
 	struct device			*dev;
 	struct regmap_irq_chip_data	*irq_data;
@@ -1346,6 +1355,7 @@
 	long				variant;
 	const struct regmap_config	*regmap_cfg;
 	const struct regmap_irq_chip	*regmap_irq_chip;
+	struct rk808_pin_info		*pins;
 };
 
 void rk8xx_shutdown(struct device *dev);
