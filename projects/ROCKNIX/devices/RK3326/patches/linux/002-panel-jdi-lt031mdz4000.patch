From: FunnyPlaying RetroPixel Pocket port
Subject: [PATCH] drm/panel: Add JDI LT031MDZ4000 3.1" 720x720 panel driver

Add support for the JDI LT031MDZ4000 panel: a 3.1" 720x720 square IPS
MIPI-DSI panel used in the FunnyPlaying RetroPixel Pocket handheld
(RK3326 variant) and sold generically by display module vendors for
Raspberry Pi / embedded projects.

The MIPI initialisation sequence was supplied by the panel vendor with
no register-level documentation and is reproduced verbatim from the
upstream Raspberry Pi community driver at
https://github.com/jamwu/RPI-LCD-LT031MDZ4000 (GPL-2.0) and cross-
verified byte-for-byte against the factory-shipped device tree blobs
distributed by FunnyPlaying for the RetroPixel Pocket.

Datasheet: https://www.panoxdisplay.com/uploadfile/datasheet/LT031MDZ4000.pdf

---
 drivers/gpu/drm/panel/Kconfig                    |  10 ++
 drivers/gpu/drm/panel/Makefile                   |   1 +
 drivers/gpu/drm/panel/panel-jdi-lt031mdz4000.c   | 274 +++++++++++++++++
 3 files changed, 285 insertions(+)
 create mode 100644 drivers/gpu/drm/panel/panel-jdi-lt031mdz4000.c

diff --git a/drivers/gpu/drm/panel/Kconfig b/drivers/gpu/drm/panel/Kconfig
--- a/drivers/gpu/drm/panel/Kconfig
+++ b/drivers/gpu/drm/panel/Kconfig
@@ -285,6 +285,16 @@ config DRM_PANEL_JDI_LPM102A188A
 	  The panel has a 2560×1800 resolution. It provides a MIPI DSI interface
 	  to the host.

+config DRM_PANEL_JDI_LT031MDZ4000
+	tristate "JDI LT031MDZ4000 3.1\" 720x720 DSI panel"
+	depends on OF
+	depends on DRM_MIPI_DSI
+	depends on BACKLIGHT_CLASS_DEVICE
+	help
+	  Say Y here if you want to enable support for the JDI LT031MDZ4000
+	  3.1" 720x720 square IPS MIPI-DSI panel as found in the FunnyPlaying
+	  RetroPixel Pocket handheld console.
+
 config DRM_PANEL_JDI_LT070ME05000
 	tristate "JDI LT070ME05000 WUXGA DSI panel"
 	depends on OF
diff --git a/drivers/gpu/drm/panel/Makefile b/drivers/gpu/drm/panel/Makefile
--- a/drivers/gpu/drm/panel/Makefile
+++ b/drivers/gpu/drm/panel/Makefile
@@ -30,6 +30,7 @@ obj-$(CONFIG_DRM_PANEL_ILITEK_ILI9881C) += panel-ilitek-ili9881c.o
 obj-$(CONFIG_DRM_PANEL_INNOLUX_EJ030NA) += panel-innolux-ej030na.o
 obj-$(CONFIG_DRM_PANEL_INNOLUX_P079ZCA) += panel-innolux-p079zca.o
 obj-$(CONFIG_DRM_PANEL_JADARD_JD9365DA_H3) += panel-jadard-jd9365da-h3.o
+obj-$(CONFIG_DRM_PANEL_JDI_LT031MDZ4000) += panel-jdi-lt031mdz4000.o
 obj-$(CONFIG_DRM_PANEL_JDI_LT070ME05000) += panel-jdi-lt070me05000.o
 obj-$(CONFIG_DRM_PANEL_JDI_LPM102A188A) += panel-jdi-lpm102a188a.o
 obj-$(CONFIG_DRM_PANEL_JDI_R63452) += panel-jdi-fhd-r63452.o
diff --git a/drivers/gpu/drm/panel/panel-jdi-lt031mdz4000.c b/drivers/gpu/drm/panel/panel-jdi-lt031mdz4000.c
new file mode 100644
--- /dev/null
+++ b/drivers/gpu/drm/panel/panel-jdi-lt031mdz4000.c
@@ -0,0 +1,274 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * JDI LT031MDZ4000 3.1" 720x720 MIPI-DSI panel driver
+ *
+ * Init sequence adapted from the Raspberry Pi community driver by
+ * jamwu (https://github.com/jamwu/RPI-LCD-LT031MDZ4000, GPL-2.0),
+ * cross-verified byte-for-byte against the factory-shipped DTB
+ * distributed by FunnyPlaying for the RetroPixel Pocket V1.0.
+ *
+ * Architecturally modelled on drivers/gpu/drm/panel/panel-elida-kd35t133.c.
+ */
+
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/regulator/consumer.h>
+
+#include <video/mipi_display.h>
+
+#include <drm/drm_mipi_dsi.h>
+#include <drm/drm_modes.h>
+#include <drm/drm_panel.h>
+
+struct jdi_lt031 {
+	struct device *dev;
+	struct drm_panel panel;
+	struct gpio_desc *reset_gpio;
+	struct regulator *vdd;
+	struct regulator *iovcc;
+	enum drm_panel_orientation orientation;
+};
+
+static inline struct jdi_lt031 *panel_to_jdi_lt031(struct drm_panel *panel)
+{
+	return container_of(panel, struct jdi_lt031, panel);
+}
+
+static void jdi_lt031_init_sequence(struct mipi_dsi_multi_context *dsi_ctx)
+{
+	/*
+	 * Vendor-supplied init sequence. The registers 0xB0, 0xBB, 0xBE, 0xD0
+	 * and 0xE4 are manufacturer-specific commands with no public
+	 * documentation. 0xB0 appears to be the standard manufacturer-command
+	 * access-protect register (unlock with 0x00, lock with 0x2F).
+	 */
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xB0, 0x00);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xE4,
+				     0x00, 0x00, 0x00, 0x00, 0x08);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xD0, 0x45, 0x45, 0x71);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0x6F, 0x01);
+	mipi_dsi_msleep(dsi_ctx, 120);
+
+	mipi_dsi_dcs_exit_sleep_mode_multi(dsi_ctx);
+	mipi_dsi_msleep(dsi_ctx, 120);
+
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xD0, 0x52, 0x4A, 0x71);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xBE,
+				     0xFF, 0x0F, 0x00, 0x18,
+				     0x04, 0x04, 0x00, 0x5D);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xBB, 0x2F);
+	mipi_dsi_msleep(dsi_ctx, 20);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xB0, 0x2F);
+}
+
+static int jdi_lt031_unprepare(struct drm_panel *panel)
+{
+	struct jdi_lt031 *ctx = panel_to_jdi_lt031(panel);
+	struct mipi_dsi_device *dsi = to_mipi_dsi_device(ctx->dev);
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = dsi };
+
+	mipi_dsi_dcs_set_display_off_multi(&dsi_ctx);
+	mipi_dsi_dcs_enter_sleep_mode_multi(&dsi_ctx);
+	if (dsi_ctx.accum_err)
+		return dsi_ctx.accum_err;
+
+	msleep(100);
+
+	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+
+	regulator_disable(ctx->iovcc);
+	regulator_disable(ctx->vdd);
+
+	return 0;
+}
+
+static int jdi_lt031_prepare(struct drm_panel *panel)
+{
+	struct jdi_lt031 *ctx = panel_to_jdi_lt031(panel);
+	struct mipi_dsi_device *dsi = to_mipi_dsi_device(ctx->dev);
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = dsi };
+
+	dsi_ctx.accum_err = regulator_enable(ctx->vdd);
+	if (dsi_ctx.accum_err) {
+		dev_err(ctx->dev, "Failed to enable vdd supply: %d\n",
+			dsi_ctx.accum_err);
+		return dsi_ctx.accum_err;
+	}
+
+	dsi_ctx.accum_err = regulator_enable(ctx->iovcc);
+	if (dsi_ctx.accum_err) {
+		dev_err(ctx->dev, "Failed to enable iovcc supply: %d\n",
+			dsi_ctx.accum_err);
+		goto disable_vdd;
+	}
+
+	msleep(20);
+
+	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+	usleep_range(10, 20);
+	gpiod_set_value_cansleep(ctx->reset_gpio, 0);
+
+	msleep(20);
+
+	jdi_lt031_init_sequence(&dsi_ctx);
+
+	mipi_dsi_dcs_set_display_on_multi(&dsi_ctx);
+	mipi_dsi_msleep(&dsi_ctx, 120);
+
+	if (dsi_ctx.accum_err)
+		goto disable_iovcc;
+
+	return 0;
+
+disable_iovcc:
+	regulator_disable(ctx->iovcc);
+disable_vdd:
+	regulator_disable(ctx->vdd);
+	return dsi_ctx.accum_err;
+}
+
+static const struct drm_display_mode jdi_lt031_default_mode = {
+	.clock		= 34653,
+	.hdisplay	= 720,
+	.hsync_start	= 720 + 21,
+	.hsync_end	= 720 + 21 + 2,
+	.htotal		= 720 + 21 + 2 + 24,
+	.vdisplay	= 720,
+	.vsync_start	= 720 + 25,
+	.vsync_end	= 720 + 25 + 5,
+	.vtotal		= 720 + 25 + 5 + 3,
+	.width_mm	= 51,
+	.height_mm	= 51,
+};
+
+static int jdi_lt031_get_modes(struct drm_panel *panel,
+			       struct drm_connector *connector)
+{
+	struct jdi_lt031 *ctx = panel_to_jdi_lt031(panel);
+	struct drm_display_mode *mode;
+
+	mode = drm_mode_duplicate(connector->dev, &jdi_lt031_default_mode);
+	if (!mode) {
+		dev_err(ctx->dev, "Failed to add mode %ux%u@%u\n",
+			jdi_lt031_default_mode.hdisplay,
+			jdi_lt031_default_mode.vdisplay,
+			drm_mode_vrefresh(&jdi_lt031_default_mode));
+		return -ENOMEM;
+	}
+
+	drm_mode_set_name(mode);
+
+	mode->type = DRM_MODE_TYPE_DRIVER | DRM_MODE_TYPE_PREFERRED;
+	connector->display_info.width_mm = mode->width_mm;
+	connector->display_info.height_mm = mode->height_mm;
+	drm_mode_probed_add(connector, mode);
+
+	return 1;
+}
+
+static enum drm_panel_orientation
+jdi_lt031_get_orientation(struct drm_panel *panel)
+{
+	struct jdi_lt031 *ctx = panel_to_jdi_lt031(panel);
+
+	return ctx->orientation;
+}
+
+static const struct drm_panel_funcs jdi_lt031_funcs = {
+	.unprepare	 = jdi_lt031_unprepare,
+	.prepare	 = jdi_lt031_prepare,
+	.get_modes	 = jdi_lt031_get_modes,
+	.get_orientation = jdi_lt031_get_orientation,
+};
+
+static int jdi_lt031_probe(struct mipi_dsi_device *dsi)
+{
+	struct device *dev = &dsi->dev;
+	struct jdi_lt031 *ctx;
+	int ret;
+
+	ctx = devm_kzalloc(dev, sizeof(*ctx), GFP_KERNEL);
+	if (!ctx)
+		return -ENOMEM;
+
+	ctx->reset_gpio = devm_gpiod_get_optional(dev, "reset", GPIOD_OUT_LOW);
+	if (IS_ERR(ctx->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(ctx->reset_gpio),
+				     "cannot get reset gpio\n");
+
+	ctx->vdd = devm_regulator_get(dev, "vdd");
+	if (IS_ERR(ctx->vdd))
+		return dev_err_probe(dev, PTR_ERR(ctx->vdd),
+				     "Failed to request vdd regulator\n");
+
+	ctx->iovcc = devm_regulator_get(dev, "iovcc");
+	if (IS_ERR(ctx->iovcc))
+		return dev_err_probe(dev, PTR_ERR(ctx->iovcc),
+				     "Failed to request iovcc regulator\n");
+
+	ret = of_drm_get_panel_orientation(dev->of_node, &ctx->orientation);
+	if (ret < 0)
+		return dev_err_probe(dev, ret,
+				     "%pOF: failed to get orientation\n",
+				     dev->of_node);
+
+	mipi_dsi_set_drvdata(dsi, ctx);
+
+	ctx->dev = dev;
+
+	dsi->lanes = 2;
+	dsi->format = MIPI_DSI_FMT_RGB888;
+	dsi->mode_flags = MIPI_DSI_MODE_VIDEO | MIPI_DSI_MODE_VIDEO_BURST |
+			  MIPI_DSI_MODE_LPM;
+
+	drm_panel_init(&ctx->panel, dev, &jdi_lt031_funcs,
+		       DRM_MODE_CONNECTOR_DSI);
+
+	ret = drm_panel_of_backlight(&ctx->panel);
+	if (ret)
+		return ret;
+
+	drm_panel_add(&ctx->panel);
+
+	ret = mipi_dsi_attach(dsi);
+	if (ret < 0) {
+		dev_err(dev, "mipi_dsi_attach failed: %d\n", ret);
+		drm_panel_remove(&ctx->panel);
+		return ret;
+	}
+
+	return 0;
+}
+
+static void jdi_lt031_remove(struct mipi_dsi_device *dsi)
+{
+	struct jdi_lt031 *ctx = mipi_dsi_get_drvdata(dsi);
+	int ret;
+
+	ret = mipi_dsi_detach(dsi);
+	if (ret < 0)
+		dev_err(&dsi->dev, "Failed to detach from DSI host: %d\n", ret);
+
+	drm_panel_remove(&ctx->panel);
+}
+
+static const struct of_device_id jdi_lt031_of_match[] = {
+	{ .compatible = "jdi,lt031mdz4000" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, jdi_lt031_of_match);
+
+static struct mipi_dsi_driver jdi_lt031_driver = {
+	.driver = {
+		.name = "panel-jdi-lt031mdz4000",
+		.of_match_table = jdi_lt031_of_match,
+	},
+	.probe	= jdi_lt031_probe,
+	.remove	= jdi_lt031_remove,
+};
+module_mipi_dsi_driver(jdi_lt031_driver);
+
+MODULE_DESCRIPTION("DRM driver for JDI LT031MDZ4000 3.1\" 720x720 MIPI-DSI panel");
+MODULE_LICENSE("GPL");
