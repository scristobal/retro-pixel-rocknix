From: RetroPixel Pocket bring-up
Subject: [PATCH] usb: dwc2: keep stock GUSBCFG timeout calibration on rppocket

The RetroPixel Pocket stock 4.4 kernel brings up the internal RTL8188EUS
module with DWC2 GUSBCFG left at 0x20001408 around host startup.  Mainline
6.12 sets GUSBCFG_TOUTCAL(7) in dwc2_core_host_init(), changing that value to
0x2000140f immediately before the port gets stuck at HPRT0=0x00001000 with no
connect interrupt.

As a board bring-up candidate, leave TOUTCAL at the stock value on this board
only.  This is intentionally narrow and diagnostic: if Wi-Fi enumerates, this
can become a documented quirk; if not, the result rules out the remaining
obvious DWC2 register delta.

---
 drivers/usb/dwc2/hcd.c | 17 +++++++++++------
 1 file changed, 11 insertions(+), 6 deletions(-)

diff --git a/drivers/usb/dwc2/hcd.c b/drivers/usb/dwc2/hcd.c
--- a/drivers/usb/dwc2/hcd.c
+++ b/drivers/usb/dwc2/hcd.c
@@ -18,6 +18,7 @@
 #include <linux/usb.h>
 
 #include <linux/usb/hcd.h>
+#include <linux/of.h>
 #include <linux/usb/ch11.h>
 #include <linux/usb/of.h>
 
@@ -2144,10 +2145,16 @@ static void dwc2_core_host_init(struct dwc2_hsotg *hsotg)
 	 * introduced by the PHY. This can be required, because the delay
 	 * introduced by the PHY in generating the linestate condition
 	 * can vary from one PHY to another.
 	 */
-	usbcfg = dwc2_readl(hsotg, GUSBCFG);
-	usbcfg |= GUSBCFG_TOUTCAL(7);
-	dwc2_writel(hsotg, usbcfg, GUSBCFG);
+	if (of_machine_is_compatible("funnyplaying,rppocket")) {
+		dev_info(hsotg->dev,
+			 "RPPDBG dwc2 keep stock TOUTCAL gusbcfg=0x%08x\n",
+			 dwc2_readl(hsotg, GUSBCFG));
+	} else {
+		usbcfg = dwc2_readl(hsotg, GUSBCFG);
+		usbcfg |= GUSBCFG_TOUTCAL(7);
+		dwc2_writel(hsotg, usbcfg, GUSBCFG);
+	}
 
 	/* Restart the Phy Clock */
 	dwc2_writel(hsotg, 0, PCGCTL);
 
